# ─────────────────────────────────────────────────────────────
# Bricks Agent Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5015
NODE_ENV=development

# MongoDB Atlas connection string
URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
SECRET=change_me_to_something_long_and_random

# Express session secret
SESSION_SECRET=another_long_random_secret

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
EMAIL=your-verified-sender@example.com

# Cloudinary
CLOUDANARY_CLOUD_NAME=your_cloud_name
CLOUDANARY_API_KEY=your_api_key
CLOUDANARY_API_SECRET=your_api_secret

# TextLocal SMS gateway
TEXTLOCAL_API_KEY=your_textlocal_api_key_base64
TEXTLOCAL_SENDER=SVTPLC

# File storage paths (only used for local disk uploads — not needed when Cloudinary is active)
PRODUCT_FOLDER=./public/images/product/
PROFILE_FOLDER=./public/images/profile/

# CORS — comma-separated list of allowed frontend origins (leave blank for *)
# Example: ALLOWED_ORIGINS=https://bricks-agent-adminpanel.web.app,https://your-custom-domain.com
ALLOWED_ORIGINS=
